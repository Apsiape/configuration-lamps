import Lamps.Basic
import Houghton.Group
import Mathlib.Data.Finset.SymmDiff
import Mathlib.Data.Finset.Image
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Group

/-!
# The configuration-lamps group `Γ` (Section `sec:group`)

`Γ` is realised as the group of permutations of `X = V × S₃` generated by `p, q, t, c, a`, where
`V = Finset Y` is the space `𝔽₂^{(Y)}` of finitely supported configurations (a finite set is the
support of a configuration; `+` is symmetric difference `∆`, `e_y = {y}`), and `S₃ = Perm (Fin 3)`.
`Y = Fin 3 × ℕ` with `(i, j)` the paper's point `(i+1, j+1)` (as in `Houghton.Group`).
Groups act on the left and Mathlib's product of permutations (right factor first) is the paper's.

* `p, q` act on configurations by the permutations `pY = a⁻¹`, `qY = b⁻¹` of `Y` (inverses, as maps,
  of the Houghton paper's `a, b`): `p(1,j) = (1,j+1)`, `p(2,1) = (1,1)`, `p(2,j) = (2,j-1)`;
* `t = τ_1` (add the point `1 = (1,1)`); `d = E_{2←1}` (add `2` if `1` is present);
* `a, b` are the transpositions `(1 2)`, `(2 3)` in the lamp at `0 = ∅`; `c = d · ab`.
-/

namespace Lamps

open Houghton (Y aPerm bPerm alPerm ρH)
open scoped symmDiff

abbrev V := Finset Y
abbrev S3 := Equiv.Perm (Fin 3)
abbrev X := V × S3

/-- The points `1 = (1,1)`, `2 = (1,2)`, `3 = (1,3)` of the first ray. -/
def e1 : Y := (0, 0)
def e2 : Y := (0, 1)
def e3 : Y := (0, 2)

/-- `H` acting on `X` through its action on configurations. -/
def hV : Equiv.Perm Y →* Equiv.Perm X where
  toFun g := Equiv.prodCongr g.finsetCongr (Equiv.refl S3)
  map_one' := by
    refine Equiv.ext fun x => Prod.ext ?_ rfl
    ext y; simp [Equiv.finsetCongr_apply, ← Equiv.Perm.inv_def]
  map_mul' g h := by
    refine Equiv.ext fun x => Prod.ext ?_ rfl
    ext y; simp [Equiv.finsetCongr_apply, Finset.mem_map_equiv, ← Equiv.Perm.inv_def, mul_inv_rev]

theorem hV_apply (g : Equiv.Perm Y) (x : X) : hV g x = (x.1.map g.toEmbedding, x.2) := rfl

/-- The translation `τ_u`. -/
def tau (u : V) : Equiv.Perm X where
  toFun x := (x.1 ∆ u, x.2)
  invFun x := (x.1 ∆ u, x.2)
  left_inv x := by simp [symmDiff_symmDiff_cancel_right]
  right_inv x := by simp [symmDiff_symmDiff_cancel_right]

/-- The transvection `d = E_{2←1}` on configurations. -/
def dV (v : V) : V := if e1 ∈ v then v ∆ {e2} else v

theorem e1_ne_e2 : e1 ≠ e2 := by decide

theorem mem_dV (v : V) : e1 ∈ dV v ↔ e1 ∈ v := by
  unfold dV; split_ifs with h
  · simp [Finset.mem_symmDiff, h, e1_ne_e2]
  · rfl

theorem dV_dV (v : V) : dV (dV v) = v := by
  unfold dV
  by_cases h : e1 ∈ v
  · have h' : e1 ∈ v ∆ {e2} := by simp [Finset.mem_symmDiff, h, e1_ne_e2]
    simp [h, h', symmDiff_symmDiff_cancel_right]
  · simp [h]

theorem dV_eq_empty (v : V) : dV v = ∅ ↔ v = ∅ := by
  constructor
  · intro h; have := congrArg dV h; rw [dV_dV] at this; rw [this]; simp [dV]
  · intro h; subst h; simp [dV]

/-- The transvection `d` as a permutation of `X`. -/
def dP : Equiv.Perm X where
  toFun x := (dV x.1, x.2)
  invFun x := (dV x.1, x.2)
  left_inv x := by simp [dV_dV]
  right_inv x := by simp [dV_dV]

/-- The lamp `σ_u`: multiply the `S₃`-coordinate by `σ` at configuration `u`. -/
def lamp (u : V) (σ : S3) : Equiv.Perm X where
  toFun x := if x.1 = u then (x.1, σ * x.2) else x
  invFun x := if x.1 = u then (x.1, σ⁻¹ * x.2) else x
  left_inv x := by
    obtain ⟨v, w⟩ := x; by_cases h : v = u
    · subst h; simp
    · simp [h]
  right_inv x := by
    obtain ⟨v, w⟩ := x; by_cases h : v = u
    · subst h; simp
    · simp [h]

/-- `a = (1 2)` and `b = (2 3)` in `S₃` (`Fin 3` indexing). -/
def sa : S3 := Equiv.swap 0 1
def sb : S3 := Equiv.swap 1 2

def pY : Equiv.Perm Y := aPerm⁻¹
def qY : Equiv.Perm Y := bPerm⁻¹

/-- The generators `p, q, t, c, a`. -/
def gen : Fin 5 → Equiv.Perm X :=
  ![hV pY, hV qY, tau {e1}, dP * lamp ∅ (sa * sb), lamp ∅ sa]

/-- The defining action `ρΓ : F →* Perm (V × S₃)`. -/
def ρΓ : F →* Equiv.Perm X := FreeGroup.lift gen

/-- The group `Γ`. -/
abbrev Γ : Subgroup (Equiv.Perm X) := ρΓ.range

theorem rho_p : ρΓ p = hV pY := by simp [ρΓ, p, gen, FreeGroup.lift_apply_of]
theorem rho_q : ρΓ q = hV qY := by simp [ρΓ, q, gen, FreeGroup.lift_apply_of]
theorem rho_t : ρΓ t = tau {e1} := by simp [ρΓ, t, gen, FreeGroup.lift_apply_of]
theorem rho_c : ρΓ c = dP * lamp ∅ (sa * sb) := by simp [ρΓ, c, gen, FreeGroup.lift_apply_of]
theorem rho_a : ρΓ a = lamp ∅ sa := by simp [ρΓ, a, gen, FreeGroup.lift_apply_of]

/-! ### Algebra of the basic permutations -/

theorem lamp_mul (u : V) (σ τ : S3) : lamp u σ * lamp u τ = lamp u (σ * τ) := by
  refine Equiv.ext fun ⟨v, w⟩ => ?_
  by_cases h : v = u
  · subst h; simp [lamp, mul_assoc]
  · simp [lamp, h]

theorem lamp_one (u : V) : lamp u 1 = 1 := by
  refine Equiv.ext fun ⟨v, w⟩ => ?_
  by_cases h : v = u
  · subst h; simp [lamp]
  · simp [lamp, h]

theorem lamp_pow (u : V) (σ : S3) (n : ℕ) : lamp u σ ^ n = lamp u (σ ^ n) := by
  induction n with
  | zero => simp [lamp_one]
  | succ n ih => rw [pow_succ, ih, lamp_mul, pow_succ]

theorem lamp_comm_ne {u w : V} (huw : u ≠ w) (σ τ : S3) :
    lamp u σ * lamp w τ = lamp w τ * lamp u σ := by
  refine Equiv.ext fun ⟨v, s⟩ => ?_
  by_cases h1 : v = u
  · subst h1
    have h2 : ¬ v = w := huw
    simp [lamp, h2]
  · by_cases h2 : v = w
    · subst h2; simp [lamp, h1]
    · simp [lamp, h1, h2]

theorem lamp_ne_one (u : V) {σ : S3} (hσ : σ ≠ 1) : lamp u σ ≠ 1 := by
  intro h
  have := congrArg (fun f : Equiv.Perm X => f (u, 1)) h
  simp [lamp] at this
  exact hσ this

theorem hV_lamp0 (g : Equiv.Perm Y) (σ : S3) : hV g * lamp ∅ σ = lamp ∅ σ * hV g := by
  refine Equiv.ext fun ⟨v, s⟩ => ?_
  by_cases h : v = ∅
  · subst h; simp [lamp, hV_apply]
  · have h' : v.map g.toEmbedding ≠ ∅ := by simpa using h
    simp [lamp, hV_apply, h, h']

theorem dP_lamp0 (σ : S3) : dP * lamp ∅ σ = lamp ∅ σ * dP := by
  refine Equiv.ext fun ⟨v, s⟩ => ?_
  by_cases h : v = ∅
  · subst h; simp [lamp, dP, dV]
  · have h' : dV v ≠ ∅ := by rwa [Ne, dV_eq_empty]
    simp [lamp, dP, h, h']

theorem tau_inv (u : V) : (tau u)⁻¹ = tau u := by
  refine Equiv.ext fun x => rfl

theorem tau_comm (u w : V) : tau u * tau w = tau w * tau u := by
  refine Equiv.ext fun x => ?_
  simp [tau, symmDiff_right_comm]

theorem tau_sq (u : V) : tau u ^ 2 = 1 := by
  refine Equiv.ext fun x => ?_
  simp [tau, pow_two, symmDiff_symmDiff_cancel_right]

theorem tau_conj_lamp (w u : V) (σ : S3) : tau w * lamp u σ * (tau w)⁻¹ = lamp (u ∆ w) σ := by
  rw [tau_inv]
  refine Equiv.ext fun ⟨v, s⟩ => ?_
  have key : v ∆ w = u ↔ v = u ∆ w := by
    constructor
    · intro h; rw [← h, symmDiff_symmDiff_cancel_right]
    · intro h; rw [h, symmDiff_symmDiff_cancel_right]
  by_cases h : v = u ∆ w
  · have h' : v ∆ w = u := key.mpr h
    subst h
    simp [tau, lamp, symmDiff_symmDiff_cancel_right]
  · have h' : ¬ v ∆ w = u := fun hh => h (key.mp hh)
    simp [tau, lamp, h', h, symmDiff_symmDiff_cancel_right]

theorem map_symmDiff' (g : Equiv.Perm Y) (v w : V) :
    (v ∆ w).map g.toEmbedding = v.map g.toEmbedding ∆ w.map g.toEmbedding := by
  simp only [Finset.map_eq_image]
  exact Finset.image_symmDiff _ _ g.injective

theorem map_map_inv (g : Equiv.Perm Y) (v : V) :
    (v.map (g⁻¹).toEmbedding).map g.toEmbedding = v := by
  ext y; simp [Finset.mem_map_equiv, ← Equiv.Perm.inv_def]

theorem hV_conj_tau (g : Equiv.Perm Y) (u : V) :
    hV g * tau u * (hV g)⁻¹ = tau (u.map g.toEmbedding) := by
  refine Equiv.ext fun x => Prod.ext ?_ rfl
  rw [← map_inv]
  simp only [Equiv.Perm.mul_apply, hV_apply, tau, Equiv.coe_fn_mk]
  rw [map_symmDiff', map_map_inv]

theorem hV_dP (g : Equiv.Perm Y) (h1 : g e1 = e1) (h2 : g e2 = e2) : hV g * dP = dP * hV g := by
  have h1' : g.symm e1 = e1 := by rw [Equiv.symm_apply_eq]; exact h1.symm
  refine Equiv.ext fun x => Prod.ext ?_ rfl
  simp only [Equiv.Perm.mul_apply, hV_apply, dP, Equiv.coe_fn_mk, dV]
  have hm : e1 ∈ x.1.map g.toEmbedding ↔ e1 ∈ x.1 := by
    rw [Finset.mem_map_equiv, h1']
  by_cases he : e1 ∈ x.1
  · rw [if_pos he, if_pos (hm.mpr he), map_symmDiff', Finset.map_singleton]
    simp [h2]
  · rw [if_neg he, if_neg (fun h => he (hm.mp h))]

theorem dP_tau_far (u : V) (hu : e1 ∉ u) : dP * tau u = tau u * dP := by
  refine Equiv.ext fun x => Prod.ext ?_ rfl
  simp only [Equiv.Perm.mul_apply, dP, tau, Equiv.coe_fn_mk, dV]
  have hm : e1 ∈ x.1 ∆ u ↔ e1 ∈ x.1 := by simp [Finset.mem_symmDiff, hu]
  by_cases he : e1 ∈ x.1
  · rw [if_pos he, if_pos (hm.mpr he), symmDiff_right_comm]
  · rw [if_neg he, if_neg (fun h => he (hm.mp h))]

theorem dP_inv : dP⁻¹ = dP := Equiv.ext fun _ => rfl

theorem dP_conj_tau1 : dP * tau {e1} * dP⁻¹ = tau {e1} * tau {e2} := by
  rw [dP_inv]
  refine Equiv.ext fun x => Prod.ext ?_ rfl
  simp only [Equiv.Perm.mul_apply, dP, tau, Equiv.coe_fn_mk, dV]
  by_cases he : e1 ∈ x.1
  · have h1 : e1 ∈ x.1 ∆ {e2} := by simp [Finset.mem_symmDiff, he, e1_ne_e2]
    have h2 : e1 ∉ x.1 ∆ {e2} ∆ {e1} := by simp [Finset.mem_symmDiff, he, e1_ne_e2]
    rw [if_pos he, if_neg h2, symmDiff_right_comm]
  · have h2 : e1 ∈ x.1 ∆ {e1} := by simp [Finset.mem_symmDiff, he]
    rw [if_neg he, if_pos h2, symmDiff_right_comm]

/-! ### Lemma `lem:structure` (a) -/

theorem sab_pow3 : (sa * sb) ^ 3 = 1 := by decide
theorem sab_ne_one : sa * sb ≠ 1 := by decide

theorem dP_sq : dP * dP = 1 := Equiv.ext fun x => by simp [dP, dV_dV]

theorem dP_lamp_pow (σ : S3) (n : ℕ) : (dP * lamp ∅ σ) ^ n = dP ^ n * lamp ∅ (σ ^ n) := by
  induction n with
  | zero => simp [lamp_one]
  | succ n ih =>
    rw [pow_succ, ih, pow_succ, pow_succ, ← lamp_mul]
    have hc : lamp ∅ (σ ^ n) * dP = dP * lamp ∅ (σ ^ n) := (dP_lamp0 _).symm
    calc dP ^ n * lamp ∅ (σ ^ n) * (dP * lamp ∅ σ)
        = dP ^ n * (lamp ∅ (σ ^ n) * dP) * lamp ∅ σ := by simp only [mul_assoc]
      _ = dP ^ n * (dP * lamp ∅ (σ ^ n)) * lamp ∅ σ := by rw [hc]
      _ = dP ^ n * dP * (lamp ∅ (σ ^ n) * lamp ∅ σ) := by simp only [mul_assoc]

theorem dP_pow_odd (n : ℕ) : dP ^ (2 * n + 1) = dP := by
  rw [pow_succ, pow_mul, sq, dP_sq, one_pow, one_mul]

theorem dP_pow_even (n : ℕ) : dP ^ (2 * n) = 1 := by
  rw [pow_mul, sq, dP_sq, one_pow]

/-- `c³ = d`. -/
theorem c_cube : ρΓ c ^ 3 = dP := by
  rw [rho_c, dP_lamp_pow, sab_pow3, lamp_one, mul_one, show 3 = 2 * 1 + 1 from rfl, dP_pow_odd]

/-- `c⁴ = ab`. -/
theorem c_four : ρΓ c ^ 4 = lamp ∅ (sa * sb) := by
  rw [rho_c, dP_lamp_pow, show 4 = 2 * 2 from rfl, dP_pow_even, one_mul, pow_mul]
  rw [show (sa * sb) ^ 2 = sa * sb * (sa * sb) from sq _]
  congr 1; decide

theorem rho_ab : ρΓ (a * b) = lamp ∅ (sa * sb) := by
  rw [b, map_mul, map_mul, map_pow, c_four, rho_a, lamp_mul, lamp_mul]
  congr 1; decide

theorem rho_b : ρΓ b = lamp ∅ sb := by
  rw [b, map_mul, map_pow, c_four, rho_a, lamp_mul]
  congr 1; decide

theorem rho_d : ρΓ d = dP := by rw [d, map_pow, c_cube]

theorem dP_ne_one : dP ≠ 1 := by
  intro h
  have := congrArg (fun f : Equiv.Perm X => (f ({e1}, 1)).1) h
  simp [dP, dV] at this

theorem dP_ne_lamp (σ : S3) : dP * lamp ∅ σ ≠ 1 := by
  intro h
  have := congrArg (fun f : Equiv.Perm X => (f ({e1}, 1)).1) h
  simp [dP, dV, lamp] at this

/-- **Lemma `lem:structure`(a)**: `c` has order six (`c⁶ = 1` and `c^m ≠ 1` for `0 < m < 6`),
`c³ = d` and `c⁴ = ab`. -/
theorem structure_a :
    (ρΓ c ^ 6 = 1 ∧ ∀ m : ℕ, 0 < m → m < 6 → ρΓ c ^ m ≠ 1) ∧ ρΓ c ^ 3 = ρΓ d ∧
      ρΓ c ^ 4 = ρΓ (a * b) := by
  refine ⟨⟨?_, fun m hm0 hm => ?_⟩, by rw [c_cube, rho_d], by rw [c_four, rho_ab]⟩
  · rw [show 6 = 3 + 3 from rfl, pow_add, c_cube, dP_sq]
  · rw [rho_c, dP_lamp_pow]
    obtain _ | _ | _ | _ | _ | _ | m := m
    · omega
    · rw [show 0 + 1 = 2 * 0 + 1 from rfl, dP_pow_odd]; exact dP_ne_lamp _
    · rw [show 0 + 1 + 1 = 2 * 1 from rfl, dP_pow_even, one_mul]
      exact lamp_ne_one _ (by decide)
    · rw [show 0 + 1 + 1 + 1 = 2 * 1 + 1 from rfl, dP_pow_odd, sab_pow3, lamp_one, mul_one]
      exact dP_ne_one
    · rw [show 0 + 1 + 1 + 1 + 1 = 2 * 2 from rfl, dP_pow_even, one_mul]
      exact lamp_ne_one _ (by decide)
    · rw [show 0 + 1 + 1 + 1 + 1 + 1 = 2 * 2 + 1 from rfl, dP_pow_odd]; exact dP_ne_lamp _
    · omega

/-- `ab ≠ 1` in `Γ`. -/
theorem rho_ab_ne_one : ρΓ (a * b) ≠ 1 := by
  rw [rho_ab]; exact lamp_ne_one _ sab_ne_one

/-! ### The Houghton part and the bridge (`app-houghton`, Conventions) -/

/-- Houghton-paper words evaluated as maps: `θ w = ((ρH w).unop)⁻¹` (a homomorphism, since inversion
reverses products); `θ a = pY`, `θ b = qY`. -/
def θ : Houghton.F →* Equiv.Perm Y where
  toFun w := ((ρH w).unop)⁻¹
  map_one' := by simp
  map_mul' x y := by simp [mul_inv_rev]

theorem θ_eq_one_iff (w : Houghton.F) : θ w = 1 ↔ ρH w = 1 := by
  show ((ρH w).unop)⁻¹ = 1 ↔ _
  rw [inv_eq_one, MulOpposite.unop_eq_one_iff]

theorem θ_a : θ Houghton.a = pY := by
  show ((ρH (FreeGroup.of 0)).unop)⁻¹ = _; rw [Houghton.rho_of]; rfl
theorem θ_b : θ Houghton.b = qY := by
  show ((ρH (FreeGroup.of 1)).unop)⁻¹ = _; rw [Houghton.rho_of]; rfl
theorem θ_α : θ Houghton.α = alPerm⁻¹ := by
  show ((ρH (FreeGroup.of 2)).unop)⁻¹ = _; rw [Houghton.rho_of]; rfl

/-- `[a, b] = α` in `H₃` (relator `r₄`). -/
theorem θ_comm_ab : pY * qY * pY⁻¹ * qY⁻¹ = alPerm⁻¹ := by
  have h := (θ_eq_one_iff Houghton.r₄).mpr (Houghton.rho_rel 3)
  simp only [Houghton.r₄, map_mul, map_inv, θ_a, θ_b, θ_α] at h
  rw [mul_inv_eq_one] at h
  simpa using h

/-- The renaming `a ↦ p, b ↦ q, α ↦ s = [p,q]`. -/
def κ : Houghton.F →* F := FreeGroup.lift ![p, q, s]

theorem κ_a : κ Houghton.a = p := by simp [κ, Houghton.a, FreeGroup.lift_apply_of]
theorem κ_b : κ Houghton.b = q := by simp [κ, Houghton.b, FreeGroup.lift_apply_of]
theorem κ_α : κ Houghton.α = s := by simp [κ, Houghton.α, FreeGroup.lift_apply_of]

theorem rho_s : ρΓ s = hV alPerm⁻¹ := by
  rw [s, comm, map_mul, map_mul, map_mul, map_inv, map_inv, rho_p, rho_q, ← map_inv, ← map_inv,
    ← map_mul, ← map_mul, ← map_mul, θ_comm_ab]

/-- `ρΓ ∘ κ = hV ∘ θ`. -/
theorem rho_κ : ρΓ.comp κ = hV.comp θ := by
  apply FreeGroup.ext_hom
  intro i
  fin_cases i
  · show ρΓ (κ Houghton.a) = hV (θ Houghton.a); rw [κ_a, θ_a, rho_p]
  · show ρΓ (κ Houghton.b) = hV (θ Houghton.b); rw [κ_b, θ_b, rho_q]
  · show ρΓ (κ Houghton.α) = hV (θ Houghton.α); rw [κ_α, θ_α, rho_s]

theorem rho_κ_apply (w : Houghton.F) : ρΓ (κ w) = hV (θ w) := DFunLike.congr_fun rho_κ w

theorem hV_injective : Function.Injective hV := by
  rw [injective_iff_map_eq_one]
  intro g hg
  ext y : 1
  have := congrArg (fun f : Equiv.Perm X => (f ({y}, 1)).1) hg
  simp only [hV_apply, Finset.map_singleton, Equiv.Perm.coe_one, id_eq] at this
  simpa using this

/-- The letters `p, q` inside `F` and `a, b` inside the Houghton free group. -/
def ιpq : FreeGroup (Fin 2) →* F := FreeGroup.lift ![p, q]
def ιab : FreeGroup (Fin 2) →* Houghton.F := FreeGroup.lift ![Houghton.a, Houghton.b]

theorem κ_ιab : κ.comp ιab = ιpq := by
  apply FreeGroup.ext_hom; intro i; fin_cases i
  · show κ (ιab (FreeGroup.of 0)) = ιpq (FreeGroup.of 0)
    simp [ιab, ιpq, FreeGroup.lift_apply_of, κ_a]
  · show κ (ιab (FreeGroup.of 1)) = ιpq (FreeGroup.of 1)
    simp [ιab, ιpq, FreeGroup.lift_apply_of, κ_b]

/-- **Bridge** (`app-houghton`, Conventions): a word in `p, q` represents `1` in `Γ` iff the same word
in the Houghton letters `a, b` represents `1` in `H₃` (Houghton paper's right-action convention). -/
theorem lampsH_one_iff (w : FreeGroup (Fin 2)) : ρΓ (ιpq w) = 1 ↔ ρH (ιab w) = 1 := by
  rw [← κ_ιab, MonoidHom.comp_apply, rho_κ_apply, ← θ_eq_one_iff, ← map_one hV]
  exact hV_injective.eq_iff

/-! ### Lemma `lem:validity`: the 25 relations hold -/

theorem rho_comm_eq_one {x y : F} (h : ρΓ x * ρΓ y = ρΓ y * ρΓ x) : ρΓ (comm x y) = 1 := by
  simp only [comm, map_mul, map_inv]
  rw [h]; group

theorem rho_tm1 : ρΓ (tm 1) = tau {e1} := by simp [tm, rho_t]
theorem rho_tm2 : ρΓ (tm 2) = tau {e2} := by
  simp only [tm, show 2 - 1 = 1 from rfl, pow_one, map_mul, map_inv, rho_p, rho_t, hV_conj_tau,
    Finset.map_singleton]
  rfl
theorem rho_tm3 : ρΓ (tm 3) = tau {e3} := by
  show ρΓ (p ^ 2 * t * p⁻¹ ^ 2) = _
  rw [show p⁻¹ ^ 2 = (p ^ 2)⁻¹ by group, map_mul, map_mul, map_inv, map_pow, rho_p, rho_t,
    ← map_pow, hV_conj_tau, Finset.map_singleton]
  rfl

theorem rho_conj_lamp (σ : S3) {x : F} (hx : ρΓ x = lamp ∅ σ) : ρΓ (t * x * t⁻¹) = lamp {e1} σ := by
  rw [map_mul, map_mul, map_inv, hx, rho_t, tau_conj_lamp]
  congr 1

theorem empty_ne_e1 : (∅ : V) ≠ {e1} := by simp

theorem hV_comm_tau (g : Equiv.Perm Y) (hg : g e1 = e1) :
    hV g * tau {e1} = tau {e1} * hV g := by
  have := hV_conj_tau g {e1}
  rw [Finset.map_singleton] at this
  simp only [Equiv.coe_toEmbedding, hg] at this
  rwa [mul_inv_eq_iff_eq_mul] at this

/-- **Lemma `lem:validity`**: every relation of Table `tab:certificate` holds in `Γ`. -/
theorem rho_rel (i : Fin 25) : ρΓ (rel i) = 1 := by
  have hH : ∀ j : Fin 5, ρΓ (κ (Houghton.rel j)) = 1 := fun j => by
    rw [rho_κ_apply, show θ (Houghton.rel j) = 1 from (θ_eq_one_iff _).mpr (Houghton.rho_rel j),
      map_one]
  have hb := rho_b
  have ha := rho_a
  have hd := rho_d
  fin_cases i
  · -- s²
    have := hH 0
    simpa [Houghton.rel, Houghton.r₁, κ_α, rel] using this
  · have := hH 1
    simpa [Houghton.rel, Houghton.r₂, κ_α, κ_a, rel] using this
  · have := hH 2
    simpa [Houghton.rel, Houghton.r₃, Houghton.comm, comm, κ_α, κ_a, rel] using this
  · have := hH 4
    simpa [Houghton.rel, Houghton.r₅, κ_α, κ_a, κ_b, rel] using this
  · -- t²
    show ρΓ (t ^ 2) = 1; rw [map_pow, rho_t, tau_sq]
  · show ρΓ (comm t (s * p)) = 1
    have hk : ρΓ (s * p) = hV (θ (Houghton.α * Houghton.a)) := by
      rw [← rho_κ_apply, map_mul (κ), κ_α, κ_a]
    apply rho_comm_eq_one
    rw [hk, rho_t, eq_comm]
    exact hV_comm_tau _ (by rw [map_mul, θ_α, θ_a]; rfl)
  · show ρΓ (comm t (s * q)) = 1
    have hk : ρΓ (s * q) = hV (θ (Houghton.α * Houghton.b)) := by
      rw [← rho_κ_apply, map_mul (κ), κ_α, κ_b]
    apply rho_comm_eq_one
    rw [hk, rho_t, eq_comm]
    exact hV_comm_tau _ (by rw [map_mul, θ_α, θ_b]; rfl)
  · show ρΓ (comm d (B * s * p)) = 1
    have hk : ρΓ (B * s * p) = hV (θ (Houghton.a * Houghton.α * Houghton.a⁻¹ * Houghton.α *
        Houghton.a)) := by
      rw [← rho_κ_apply]; simp only [map_mul, map_inv, κ_a, κ_α, B]
    apply rho_comm_eq_one
    rw [hk, hd, eq_comm]
    apply hV_dP
    · simp only [map_mul, map_inv, θ_α, θ_a]; rfl
    · simp only [map_mul, map_inv, θ_α, θ_a]; rfl
  · show ρΓ (comm d (B * s * q)) = 1
    have hk : ρΓ (B * s * q) = hV (θ (Houghton.a * Houghton.α * Houghton.a⁻¹ * Houghton.α *
        Houghton.b)) := by
      rw [← rho_κ_apply]; simp only [map_mul, map_inv, κ_a, κ_b, κ_α, B]
    apply rho_comm_eq_one
    rw [hk, hd, eq_comm]
    apply hV_dP
    · simp only [map_mul, map_inv, θ_α, θ_a, θ_b]; rfl
    · simp only [map_mul, map_inv, θ_α, θ_a, θ_b]; rfl
  · show ρΓ (comm p a) = 1
    exact rho_comm_eq_one (by rw [rho_p, ha, hV_lamp0])
  · show ρΓ (comm p b) = 1
    exact rho_comm_eq_one (by rw [rho_p, hb, hV_lamp0])
  · show ρΓ (comm q a) = 1
    exact rho_comm_eq_one (by rw [rho_q, ha, hV_lamp0])
  · show ρΓ (comm q b) = 1
    exact rho_comm_eq_one (by rw [rho_q, hb, hV_lamp0])
  · show ρΓ (comm d a) = 1
    exact rho_comm_eq_one (by rw [hd, ha, dP_lamp0])
  · show ρΓ (comm (tm 1) (tm 2)) = 1
    exact rho_comm_eq_one (by rw [rho_tm1, rho_tm2, tau_comm])
  · show ρΓ (d * tm 1 * d⁻¹ * (tm 1 * tm 2)⁻¹) = 1
    rw [map_mul, map_mul, map_mul, map_inv, map_inv, map_mul, hd, rho_tm1, rho_tm2,
      dP_conj_tau1, mul_inv_cancel]
  · show ρΓ (comm d (tm 2)) = 1
    exact rho_comm_eq_one (by rw [hd, rho_tm2]; exact dP_tau_far _ (by simp [e1_ne_e2]))
  · show ρΓ (comm d (tm 3)) = 1
    exact rho_comm_eq_one (by rw [hd, rho_tm3]; exact dP_tau_far _ (by decide))
  · show ρΓ (a ^ 2) = 1
    rw [map_pow, ha, lamp_pow, show sa ^ 2 = 1 by decide, lamp_one]
  · show ρΓ (b ^ 2) = 1
    rw [map_pow, hb, lamp_pow, show sb ^ 2 = 1 by decide, lamp_one]
  · show ρΓ ((a * b) ^ 3) = 1
    rw [map_pow, rho_ab, lamp_pow, sab_pow3, lamp_one]
  · show ρΓ (comm a (t * a * t⁻¹)) = 1
    exact rho_comm_eq_one (by rw [ha, rho_conj_lamp sa ha, lamp_comm_ne empty_ne_e1])
  · show ρΓ (comm a (t * b * t⁻¹)) = 1
    exact rho_comm_eq_one (by rw [ha, rho_conj_lamp sb hb, lamp_comm_ne empty_ne_e1])
  · show ρΓ (comm b (t * a * t⁻¹)) = 1
    exact rho_comm_eq_one (by rw [hb, rho_conj_lamp sa ha, lamp_comm_ne empty_ne_e1])
  · show ρΓ (comm b (t * b * t⁻¹)) = 1
    exact rho_comm_eq_one (by rw [hb, rho_conj_lamp sb hb, lamp_comm_ne empty_ne_e1])

end Lamps
